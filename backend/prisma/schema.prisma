// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  es_ES
  en_US
  pt_BR
  fr_FR
  de_DE
}

enum WatchlistType {
  movie
  tv
}

enum WatchlistStatus {
  pending
  watching
  watched
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  password       String
  name           String?
  language       Language        @default(es_ES)
  createdAt      DateTime        @default(now())
  watchlistItems WatchlistItem[]
}

// One row per user per title added to their watchlist. tmdbId + type
// together identify a title in TMDb (movies and TV shows have separate
// id spaces, so the same numeric id can mean two different titles).
model WatchlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  tmdbId    Int
  type      WatchlistType
  status    WatchlistStatus @default(pending)
  rating    Int?
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Every query on this table filters by userId — this index keeps those
  // lookups fast as the table grows.
  @@index([userId])
  @@unique([userId, tmdbId, type])
}